# Didit uses the same API host for both modes. The selected key chooses the
# Didit environment. Keep Didit credentials server-only; never prefix them NEXT_PUBLIC_.
DIDIT_ENVIRONMENT=sandbox

# Point WorkSync at the Supabase project selected for this environment.
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-side-supabase-service-role-key
APP_URL=http://localhost:3000

# Sandbox credentials and workflow from the Didit Sandbox application.
DIDIT_SANDBOX_API_KEY=replace-with-sandbox-api-key
DIDIT_SANDBOX_WORKFLOW_ID=00000000-0000-0000-0000-000000000000
DIDIT_SANDBOX_WEBHOOK_SECRET=replace-with-sandbox-webhook-signing-secret
# Optional for the 24-hour Didit signing-secret rotation window.
DIDIT_SANDBOX_WEBHOOK_SECRET_PREVIOUS=

# Must match NEXT_PUBLIC_SUPABASE_URL. Use "local" with a local Supabase URL.
# Sandbox writes are blocked on Vercel production deployments.
DIDIT_SANDBOX_SUPABASE_PROJECT_REF=your-supabase-project-ref

# Keep Live credentials separate. Set DIDIT_ENVIRONMENT=live only in an
# environment intentionally configured for Live verification.
DIDIT_LIVE_API_KEY=replace-with-live-api-key
DIDIT_LIVE_WORKFLOW_ID=00000000-0000-0000-0000-000000000000
DIDIT_LIVE_WEBHOOK_SECRET=replace-with-live-webhook-signing-secret
# Optional for the 24-hour Didit signing-secret rotation window.
DIDIT_LIVE_WEBHOOK_SECRET_PREVIOUS=

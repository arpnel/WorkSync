# Server-only HMAC secret used to detect possible duplicate identity submissions.
# Generate at least 32 random bytes and rotate only with a planned fingerprint migration.
IDENTITY_FINGERPRINT_SECRET=replace-with-at-least-32-random-bytes

NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-side-supabase-service-role-key
APP_URL=http://localhost:3000
